{
  "name": "tictactoe",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade real-time multiplayer Tic-Tac-Toe",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build && vite build",
    "build:server": "tsc --build",
    "build:client": "vite build",
    "build:watch": "tsc --build --watch",
    "start": "node dist/server/index.js",
    "dev:server": "node --watch dist/server/index.js",
    "dev:client": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.3.4",
    "vitest": "^1.2.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
