# Copy to .env and adjust as needed. All values shown are the defaults.

# HTTP + WebSocket listen port.
PORT=8080

# Version string reported by /health, /metrics, and AUTH_ACK.
SERVER_VERSION=0.1.0

# Exact browser origin allowed for CORS and the WebSocket upgrade.
# Comma-separate multiple origins. Use "*" only for local development.
CORS_ORIGIN=http://localhost:3000

# Path to the completed-game history file. Use ":memory:" to disable persistence.
HISTORY_FILE=data/history.json
